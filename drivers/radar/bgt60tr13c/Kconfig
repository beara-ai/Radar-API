config BGT60TR13C
	bool "Infineon BGT60TR13C mmWave radar driver"
	default y
	depends on DT_HAS_INFINEON_BGT60TR13C_ENABLED
	depends on RADAR_FMCW
	select SPI_ASYNC
	select SPI
	select GPIO
	help
	  Thin driver: retrieves raw ADC frames from the BGT60TR13C over SPI
	  and delivers them through the generic FMCW radar API
	  (zephyr/drivers/radar_fmcw.h), which also reports the frame
	  configuration. Frames are the FIFO's data as read, packed 12-bit
	  samples with the receivers interleaved, so the driver neither
	  unpacks nor reorders them. Does no signal processing itself.

if BGT60TR13C

module = BGT60TR13C
module-str = bgt60tr13c
source "subsys/logging/Kconfig.template.log_config"

config BGT60TR13C_FIFO_CHUNK_SAMPLES
	int "Samples read per FIFO interrupt"
	default 1024
	range 2 8192
	help
	  Sets the sensor's FIFO compare-reference (CREF) threshold: the
	  number of samples buffered on-chip before it raises an interrupt.
	  Must be even (sensor requirement) and must fit within the physical
	  FIFO. Frames larger than this are drained across
	  multiple interrupts automatically. Each read goes straight into the
	  frame buffer, so a larger value means fewer interrupts and longer
	  SPI transfers, but no extra RAM.

# Each radar picks its register list (profile) with its devicetree
# register-profile property, and describes the frames it produces with the
# generic radar-fmcw.yaml properties; see dts/bindings/radar. The build
# fails if the two disagree. These options only add a custom profile.

config BGT60TR13C_PROFILE_CUSTOM
	bool "Custom register profile header"
	help
	  Compile in your own bgt60-configurator-cli output, named by
	  BGT60TR13C_PROFILE_CUSTOM_FILE, for radars whose devicetree node
	  sets register-profile = "custom". Set that node's frame properties
	  (start-freq-khz, samples-per-chirp, rx-mask and so on) to match it.

config BGT60TR13C_PROFILE_CUSTOM_FILE
	string "Custom register profile header"
	depends on BGT60TR13C_PROFILE_CUSTOM
	help
	  Header generated by bgt60-configurator-cli, e.g.
	  "my_profile.h", found on the include path: add its directory with
	  zephyr_include_directories() in the application's CMakeLists.txt.

endif # BGT60TR13C
